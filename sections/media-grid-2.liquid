{%- comment -%}
  Media grid featured layout V2
  Pattern per 5 blocks:
  - block 1 = big featured banner
  - blocks 2 to 5 = four small tiles
  Featured/banner position: left or right
  Media aspect ratio controls the full group and tiles.
  V2 FIX: Natural aspect ratio now shows full image content
{%- endcomment -%}

{%- if section.index > 2 -%}
  <link rel="stylesheet" href="{{ 'gallery.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- if section.settings.mobile_carousel -%}
    <link rel="stylesheet" href="{{ 'gallery-mobile-carousel.css' | asset_url }}" media="print" onload="this.media='all'">
  {%- endif -%}
{%- else -%}
  {{ 'gallery.css' | asset_url | stylesheet_tag }}
  {%- if section.settings.mobile_carousel -%}
    {{ 'gallery-mobile-carousel.css' | asset_url | stylesheet_tag }}
  {%- endif -%}
{%- endif -%}

{%- for block in section.blocks -%}
  {%- if block.settings.video_shopify != blank -%}
    {%- if section.index > 2 -%}
      <link rel="stylesheet" href="{{ 'video.css' | asset_url }}" media="print" onload="this.media='all'">
    {%- else -%}
      {{ 'video.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    <script src="{{ 'video.js' | asset_url }}" defer="defer"></script>
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- liquid
  assign breakpoint_md = 769
  assign section_width = section.settings.setwidth | default: 'container'
  assign text_color_scheme = section.settings.color_scheme
  assign use_featured_mobile_layout = false
  if section.settings.mobile_carousel and section.settings.mobile_layout_style == 'featured_cards'
    assign use_featured_mobile_layout = true
  endif

  if text_color_scheme == 'white'
    assign brightness = section.settings.transparent_content_color | color_brightness
    assign alpha = section.settings.transparent_content_color | color_extract: 'alpha'
    if brightness < 190 and alpha > 0
      assign transparent_text_contrast = '255 255 255'
      assign transparent_hover_color = section.settings.transparent_content_color | color_lighten: 10
    else
      assign transparent_text_contrast = '0 0 0'
      assign transparent_hover_color = section.settings.transparent_content_color | color_darken: 10
    endif
  endif

  assign section_color_scheme = section.settings.section_color_scheme
  assign section_bg_color = false

  if section_color_scheme == '1'
    assign section_bg_color = settings.color_scheme_1_bg
  elsif section_color_scheme == '2'
    assign section_bg_color = settings.color_scheme_2_bg
  elsif section_color_scheme == '3'
    assign section_bg_color = settings.color_scheme_3_bg
  endif

  if section_bg_color and section_bg_color != settings.bg_color
    assign section_bg_alpha = bg_color | color_extract: 'alpha'
    unless section_bg_alpha > 0
      assign section_bg_color = false
    endunless
  else
    assign section_bg_color = false
  endif

  if section.settings.image_ratio == 'shortest'
    assign image_ratio = 0
    for block in section.blocks
      assign this_image_ratio = block.settings.image.aspect_ratio | default: 1.77
      if this_image_ratio > image_ratio
        assign image_ratio = this_image_ratio
      endif
    endfor
  elsif section.settings.image_ratio == 'tallest'
    assign image_ratio = 99
    for block in section.blocks
      assign this_image_ratio = block.settings.image.aspect_ratio | default: 1.77
      if this_image_ratio < image_ratio
        assign image_ratio = this_image_ratio
      endif
    endfor
  else
    assign image_ratio = section.settings.image_ratio
  endif

  if section_bg_color and section_bg_color != settings.bg_color
    assign section_bg_alpha = section_bg_color | color_extract: 'alpha'
    unless section_bg_alpha > 0
      assign section_bg_color = false
    endunless
  else
    assign section_bg_color = false
  endif

  # Grid classes for mobile carousel support
  assign grid_classes = 'gallery grid'
  
  if section.settings.mobile_carousel and use_featured_mobile_layout == false
    assign grid_classes = grid_classes | append: ' slider--mobile'
  else
    if section.settings.gallery_cols_min == '1'
      assign grid_classes = grid_classes | append: ' grid-cols-1 sm:grid-cols-2'
    else
      assign grid_classes = grid_classes | append: ' grid-cols-2'
    endif
  endif
  
  if section.settings.gallery_cols_max == 4
    assign grid_classes = grid_classes | append: ' lg:grid-cols-4'
  elsif section.settings.gallery_cols_max == 3
    assign grid_classes = grid_classes | append: ' lg:grid-cols-3'
  endif
%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --smg-gap: {{ section.settings.grid_gap }}px;
    --smg-mobile-height: {{ section.settings.fixed_height_mobile }}px;
    --smg-desktop-height: {{ section.settings.fixed_height_desktop }}px;
  }

  {%- if text_color_scheme == 'white' -%}
    #shopify-section-{{ section.id }} {
      --color-scheme-white-text: {{ section.settings.transparent_content_color.red }} {{ section.settings.transparent_content_color.green }} {{ section.settings.transparent_content_color.blue }};
      --color-scheme-white-hover: {{ transparent_hover_color.red }} {{ transparent_hover_color.green }} {{ transparent_hover_color.blue }};
      --color-scheme-white-text-contrast: {{ transparent_text_contrast }};
    }
  {%- endif -%}

  {% for block in section.blocks %}
    {%- if block.settings.tint_opacity > 0 -%}
      #shopify-section-{{ section.id }} .block-{{ block.id }} .media::after {
        background-color: rgba({{ block.settings.tint_color.red }}, {{ block.settings.tint_color.green }}, {{ block.settings.tint_color.blue }}, {{ block.settings.tint_opacity | divided_by: 100.0 }});
      }
    {%- endif -%}
  {% endfor %}

  #shopify-section-{{ section.id }} .gallery-block {
    min-height: var(--smg-mobile-height);
  }

  @media (min-width: {{ breakpoint_md }}px) {
    #shopify-section-{{ section.id }} .gallery-block {
      min-height: calc(var(--smg-desktop-height) + 8vw);
    }
  }
  
  /* Media aspect ratio styles */
  #shopify-section-{{ section.id }} .media {
    {% if section.settings.image_ratio == "natural" %}
      padding-top: 0 !important;
    {% elsif image_ratio > 0 and image_ratio != 0 %}
      padding-top: {{ 1 | divided_by: image_ratio | times: 100 }}%;
    {% endif %}
  }
  
  /* =========================================
     FEATURED POSITION FIX - DIRECT CLASS APPROACH
  ========================================= */
  
  @media (min-width: {{ breakpoint_md }}px) {
    #shopify-section-{{ section.id }} .featured-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--smg-gap);
      grid-auto-flow: dense;
    }
    
    /* Featured item base style */
    #shopify-section-{{ section.id }} .featured-item {
      grid-column: span 2;
      grid-row: span 2;
    }
    
    /* Featured RIGHT position */
    #shopify-section-{{ section.id }}[data-featured-position="right"] .featured-item {
      grid-column: 3 / span 2;
    }
    
    /* Featured LEFT position */
    #shopify-section-{{ section.id }}[data-featured-position="left"] .featured-item {
      grid-column: 1 / span 2;
    }
  }
  
  /* Mobile reset */
  @media (max-width: {{ breakpoint_md | minus: 1 }}px) {
    #shopify-section-{{ section.id }} .featured-item {
      grid-column: span 2 !important;
    }
  }
  
  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .featured-grid {
      grid-template-columns: 1fr !important;
    }
    
    #shopify-section-{{ section.id }} .featured-item {
      grid-column: span 1 !important;
    }
  }

  #shopify-section-{{ section.id }} > .container-fluid,
  #shopify-section-{{ section.id }} .container-fluid {
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} > .full,
  #shopify-section-{{ section.id }} .full {
    width: 100%;
    max-width: 100%;
    padding-left: 0;
    padding-right: 0;
  }

  #shopify-section-{{ section.id }} .full .img-fit {
    object-fit: cover;
  }

  /* Mobile layout: featured banner + cards slider */
  #shopify-section-{{ section.id }} .mg2-mobile-layout {
    display: none;
  }

  @media (max-width: {{ breakpoint_md | minus: 1 }}px) {
    #shopify-section-{{ section.id }} .mg2-desktop-grid--with-mobile-layout {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .mg2-mobile-layout--active {
      display: block;
    }

    #shopify-section-{{ section.id }} .mg2-mobile-featured .gallery-block {
      width: 100%;
      margin-bottom: var(--smg-gap);
    }

    #shopify-section-{{ section.id }} .mg2-mobile-cards {
      display: flex;
      gap: var(--smg-gap);
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-padding-left: var(--gutter);
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    #shopify-section-{{ section.id }} .mg2-mobile-cards.is-dragging {
      cursor: grabbing;
      user-select: none;
    }

    #shopify-section-{{ section.id }} .mg2-mobile-cards::-webkit-scrollbar {
      display: none;
    }

    #shopify-section-{{ section.id }} .mg2-mobile-cards .gallery-block {
      flex: 0 0 calc(50% - (var(--smg-gap) / 2));
      min-width: 240px;
      scroll-snap-align: start;
    }

    {% if section.settings.image_ratio == "natural" %}
      /* Natural ratio mobile: show full image content and one card per view */
      #shopify-section-{{ section.id }} .mg2-mobile-cards .gallery-block {
        flex: 0 0 100%;
        min-width: 100%;
      }

      #shopify-section-{{ section.id }} .mg2-mobile-layout .media img.img-fit {
        position: static !important;
        width: 100% !important;
        height: auto !important;
        object-fit: contain !important;
      }
    {% endif %}

    #shopify-section-{{ section.id }} .mg2-mobile-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 14px;
    }

    #shopify-section-{{ section.id }} .mg2-mobile-dot {
      width: 10px;
      height: 10px;
      border: 1px solid currentColor;
      border-radius: 999px;
      background: transparent;
      padding: 0;
      opacity: 0.6;
    }

    #shopify-section-{{ section.id }} .mg2-mobile-dot.is-active {
      background: currentColor;
      opacity: 1;
    }

  }
{%- endstyle -%}

<div class="section{% unless section_color_scheme == 'none' %} color-scheme color-scheme--{{ section_color_scheme }} section--padded section--full-width{% endunless %}" 
     id="shopify-section-{{ section.id }}"
     data-featured-position="{{ section.settings.featured_position }}">
  
  {%- if section.settings.title != blank or section.settings.button_label != blank -%}
    <div class="{{ section_width }}">
      <div class="section__header items-center flex{% if section.settings.heading_align == 'text-center' %} flex-col text-center{% elsif section.settings.heading_align == 'text-end' %} flex-row-reverse flex-wrap{% else %} flex-row flex-wrap{% endif %} gap-x-theme"{% if settings.animations_enabled != 'disabled' %} data-cc-animate{% endif %}>
        {%- if section.settings.title != blank -%}
          <h2 class="h4 section__heading mb-0 flex-auto {{ section.settings.heading_align }}">
            {{- section.settings.title | escape -}}
          </h2>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link }}" class="link">{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {% if section.settings.mobile_carousel and use_featured_mobile_layout == false %}<div class="gallery-mobile-carousel">{% endif %}

  <div class="{{ section_width }}">
    <div class="mg2-mobile-layout{% if use_featured_mobile_layout %} mg2-mobile-layout--active{% endif %}">
      {%- if use_featured_mobile_layout and section.blocks.size > 0 -%}
        {%- assign featured_block = section.blocks.first -%}
        {%- liquid
          assign featured_img = featured_block.settings.image
          assign featured_overlay_position = featured_block.settings.overlay_position | split: ' '
          assign featured_is_link = true
          if featured_block.settings.title contains '<a' or featured_block.settings.button_link != blank or featured_block.settings.link_url == blank
            assign featured_is_link = false
          endif
          assign featured_image_class = 'img-fit'
          if section.settings.image_fit == 'contain'
            assign featured_image_class = featured_image_class | append: ' img-fit--contain'
          endif
        -%}

        <div class="mg2-mobile-featured">
          {% if featured_is_link %}<a href="{{ featured_block.settings.link_url }}" {% else %}<div {% endif %}class="block-{{ featured_block.id }} block relative flex flex-col gallery-block h-full{% if featured_is_link %} card__media{% endif %}">
            <div class="gallery-block__image{% if featured_block.settings.video_shopify != blank %} video-section{% endif %} overflow-hidden flex relative w-full h-full {{ featured_overlay_position | first }} {{ featured_overlay_position | last }}{% if featured_is_link %} card__media{% endif %}">
              <div class="media media--has-overlay flex absolute top-0 left-0 w-full h-full has-motion"{% unless section.settings.image_ratio == "natural" %} style="padding-top: {{ 1 | divided_by: image_ratio | times: 100 }}%;"{% endunless %}>
                {%- if featured_img != blank -%}
                  {% render 'image',
                    image: featured_img,
                    widths: '480, 800, 980, 1200, 1440, 1920',
                    src_width: 1200,
                    sizes: '100vw',
                    quality: 1,
                    section_index: section.index,
                    class: featured_image_class
                  %}
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit' }}
                {%- endif -%}
              </div>

              {%- if featured_block.settings.video_shopify != blank -%}
                <deferred-media class="video-section__media media media--has-overlay overflow-hidden absolute top-0 left-0 w-full h-full">
                  <template>
                    <video-component class="has-iframe absolute top-0 left-0 w-full h-full no-js-hidden" data-autoplay="true" data-background="true">
                      {{ featured_block.settings.video_shopify | video_tag: class: 'img-fit pointer-events-none', playsinline: true, autoplay: true, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                    </video-component>
                  </template>
                </deferred-media>
              {%- endif -%}

              {%- if featured_block.settings.title != blank or featured_block.settings.subheading != blank or featured_block.settings.button_label != blank -%}
                <div class="gallery-block__image-text{% if text_color_scheme == 'white' %} gallery-block__image-text--transparent{% endif %} color-scheme color-scheme--{{ text_color_scheme }} text-overlay text-overlay--grow {{ featured_block.settings.text_alignment }} relative">
                  {%- if featured_block.settings.subheading != blank -%}
                    <p class="text-overlay__block subheading text-current">
                      {{- featured_block.settings.subheading | escape -}}
                    </p>
                  {%- endif -%}
                  {%- if featured_block.settings.title != blank -%}
                    <h3 class="text-current mb-0 rte {{ featured_block.settings.heading_size }}">
                      {{- featured_block.settings.title | newline_to_br -}}
                    </h3>
                  {%- endif -%}
                  {%- if featured_block.settings.button_label != blank -%}
                    <div class="text-overlay__block text-overlay__buttons inline-flex flex-wrap mt-4{% if featured_block.settings.text_alignment == 'text-start' %} justify-start{% elsif featured_block.settings.text_alignment == 'text-end' %} justify-end{% else %} justify-center{% endif %}">
                      <{% if featured_block.settings.button_link == blank %}button{% else %}a{% endif %} class="{{ featured_block.settings.button_style }}" {% if featured_block.settings.button_link == blank and featured_is_link == false %}role="link" aria-disabled="true"{% else %}href="{{ featured_block.settings.button_link }}"{% endif %}>
                        {{- featured_block.settings.button_label | escape -}}
                      </{% if featured_block.settings.button_link == blank %}button{% else %}a{% endif %}>
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          {% if featured_is_link %}</a>{% else %}</div>{% endif %}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="mg2-mobile-cards" data-mg2-cards>
            {%- for block in section.blocks offset: 1 -%}
              {%- liquid
                assign img = block.settings.image
                assign overlay_position = block.settings.overlay_position | split: ' '
                assign is_link = true
                if block.settings.title contains '<a' or block.settings.button_link != blank or block.settings.link_url == blank
                  assign is_link = false
                endif
                assign block_image_class = 'img-fit'
                if section.settings.image_fit == 'contain'
                  assign block_image_class = block_image_class | append: ' img-fit--contain'
                endif
              -%}

              {% if is_link %}<a href="{{ block.settings.link_url }}" {% else %}<div {% endif %}class="block-{{ block.id }} block relative flex flex-col gallery-block h-full{% if is_link %} card__media{% endif %}">
                <div class="gallery-block__image{% if block.settings.video_shopify != blank %} video-section{% endif %} overflow-hidden flex relative w-full h-full {{ overlay_position | first }} {{ overlay_position | last }}{% if is_link %} card__media{% endif %}">
                  <div class="media media--has-overlay flex absolute top-0 left-0 w-full h-full has-motion"{% unless section.settings.image_ratio == "natural" %} style="padding-top: {{ 1 | divided_by: image_ratio | times: 100 }}%;"{% endunless %}>
                    {%- if img != blank -%}
                      {% render 'image',
                        image: img,
                        widths: '480, 800, 980, 1200, 1440',
                        src_width: 980,
                        sizes: '(max-width: 768px) 50vw, 25vw',
                        quality: 1,
                        section_index: section.index,
                        class: block_image_class
                      %}
                    {%- else -%}
                      {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit' }}
                    {%- endif -%}
                  </div>
                  {%- if block.settings.video_shopify != blank -%}
                    <deferred-media class="video-section__media media media--has-overlay overflow-hidden absolute top-0 left-0 w-full h-full">
                      <template>
                        <video-component class="has-iframe absolute top-0 left-0 w-full h-full no-js-hidden" data-autoplay="true" data-background="true">
                          {{ block.settings.video_shopify | video_tag: class: 'img-fit pointer-events-none', playsinline: true, autoplay: true, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                        </video-component>
                      </template>
                    </deferred-media>
                  {%- endif -%}
                  {%- if block.settings.title != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
                    <div class="gallery-block__image-text{% if text_color_scheme == 'white' %} gallery-block__image-text--transparent{% endif %} color-scheme color-scheme--{{ text_color_scheme }} text-overlay text-overlay--grow {{ block.settings.text_alignment }} relative">
                      {%- if block.settings.subheading != blank -%}
                        <p class="text-overlay__block subheading text-current">
                          {{- block.settings.subheading | escape -}}
                        </p>
                      {%- endif -%}
                      {%- if block.settings.title != blank -%}
                        <h3 class="text-current mb-0 rte {{ block.settings.heading_size }}">
                          {{- block.settings.title | newline_to_br -}}
                        </h3>
                      {%- endif -%}
                      {%- if block.settings.button_label != blank -%}
                        <div class="text-overlay__block text-overlay__buttons inline-flex flex-wrap mt-4{% if block.settings.text_alignment == 'text-start' %} justify-start{% elsif block.settings.text_alignment == 'text-end' %} justify-end{% else %} justify-center{% endif %}">
                          <{% if block.settings.button_link == blank %}button{% else %}a{% endif %} class="{{ block.settings.button_style }}" {% if block.settings.button_link == blank and is_link == false %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}>
                            {{- block.settings.button_label | escape -}}
                          </{% if block.settings.button_link == blank %}button{% else %}a{% endif %}>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {% if is_link %}</a>{% else %}</div>{% endif %}
            {%- endfor -%}
          </div>

          <div class="mg2-mobile-dots" data-mg2-dots>
            {%- for block in section.blocks offset: 1 -%}
              <button type="button" class="mg2-mobile-dot{% if forloop.first %} is-active{% endif %}" data-mg2-dot="{{ forloop.index0 }}" aria-label="Go to card {{ forloop.index }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- endif -%}
    </div>

    <div class="featured-grid {{ grid_classes }}{% if use_featured_mobile_layout %} mg2-desktop-grid--with-mobile-layout{% endif %}" style="gap: {{ section.settings.grid_gap }}px;">
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign overlay_position = block.settings.overlay_position | split: ' '
          assign is_link = true
          if block.settings.title contains '<a' or block.settings.button_link != blank or block.settings.link_url == blank
            assign is_link = false
          endif

          # Determine if this is a featured block (first in each group of 5)
          assign item_index = forloop.index0 | modulo: 5
          assign is_feature = false
          if item_index == 0
            assign is_feature = true
          endif
          
          # Set column span classes for featured item
          if is_feature
            assign item_class = 'featured-item'
            if section.settings.mobile_carousel
              assign col_span_class = 'lg:col-span-2 snap-start'
            else
              if section.settings.gallery_cols_min == '1'
                assign col_span_class = 'col-span-1 sm:col-span-2 lg:col-span-2'
              else
                assign col_span_class = 'col-span-2 lg:col-span-2'
              endif
            endif
          else
            assign item_class = ''
            if section.settings.mobile_carousel
              assign col_span_class = 'lg:col-span-1 snap-start'
            else
              if section.settings.gallery_cols_min == '1'
                assign col_span_class = 'col-span-1 sm:col-span-1 lg:col-span-1'
              else
                assign col_span_class = 'col-span-1 lg:col-span-1'
              endif
            endif
          endif
        -%}

        {% if is_link %}<a href="{{ block.settings.link_url }}" {% else %}<div {% endif %}class="block-{{ block.id }} block relative flex flex-col gallery-block h-full {{ item_class }} {{ col_span_class }} {% if is_link %} card__media{% endif %}" {%- unless forloop.first %}tabindex="-1"{% endunless %} {{ block.shopify_attributes }}>

          <div class="gallery-block__image{% if block.settings.video_shopify != blank %} video-section{% endif %} overflow-hidden flex relative w-full h-full {{ overlay_position | first }} {{ overlay_position | last }}{% if is_link %} card__media{% endif %}">
            <div class="media media--has-overlay flex absolute top-0 left-0 w-full h-full has-motion"{% unless section.settings.image_ratio == "natural" %} style="padding-top: {{ 1 | divided_by: image_ratio | times: 100 }}%;"{% endunless %}>
              {%- if img != blank -%}
                {%- capture sizes -%}
                  {%- if is_feature -%}
                    (min-width: 1024px) 50vw, (min-width: 769px) 50vw, {% if section.settings.gallery_cols_min == '1' %}100vw{% else %}50vw{% endif %}
                  {%- else -%}
                    (min-width: 1024px) 25vw, (min-width: 769px) 25vw, {% if section.settings.gallery_cols_min == '1' %}100vw{% else %}50vw{% endif %}
                  {%- endif -%}
                {%- endcapture -%}
                {%- liquid
                  assign block_image_class = 'img-fit'
                  if section.settings.image_fit == 'contain'
                    assign block_image_class = block_image_class | append: ' img-fit--contain'
                  endif
                -%}
                {% render 'image',
                  image: img,
                  widths: '480, 800, 980, 1200, 1440, 1920',
                  src_width: 1200,
                  sizes: sizes,
                  quality: 1,
                  section_index: section.index,
                  class: block_image_class
                %}
              {%- else -%}
                {{ 'lifestyle-2' | placeholder_svg_tag: 'media__placeholder img-fit' }}
              {%- endif -%}
            </div>

            {%- if block.settings.video_shopify != blank -%}
              <deferred-media class="video-section__media media media--has-overlay overflow-hidden absolute top-0 left-0 w-full h-full">
                <template>
                  <video-component class="has-iframe absolute top-0 left-0 w-full h-full no-js-hidden" data-autoplay="true" data-background="true">
                    {{ block.settings.video_shopify | video_tag: class: 'img-fit pointer-events-none', playsinline: true, autoplay: true, muted: true, loop: true, controls: false, poster: '' | replace: '<img ', '<img loading="lazy" hidden ' }}
                  </video-component>
                </template>
              </deferred-media>
            {%- endif -%}

            {%- if block.settings.title != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
              <div class="gallery-block__image-text{% if text_color_scheme == 'white' %} gallery-block__image-text--transparent{% endif %} color-scheme color-scheme--{{ text_color_scheme }} text-overlay text-overlay--grow {{ block.settings.text_alignment }} relative"{% if settings.animations_enabled != 'disabled' %} data-cc-animate{% endif %}>
                {%- if block.settings.subheading != blank -%}
                  <p class="text-overlay__block subheading text-current">
                    {{- block.settings.subheading | escape -}}
                  </p>
                {%- endif -%}

                {%- if block.settings.title != blank -%}
                  <h3 class="text-current mb-0 rte {{ block.settings.heading_size }}">
                    {{- block.settings.title | newline_to_br -}}
                  </h3>
                {%- endif -%}

                {%- if block.settings.button_label != blank -%}
                  <div class="text-overlay__block text-overlay__buttons inline-flex flex-wrap mt-4{% if block.settings.text_alignment == 'text-start' %} justify-start{% elsif block.settings.text_alignment == 'text-end' %} justify-end{% else %} justify-center{% endif %}">
                    <{% if block.settings.button_link == blank %}button{% else %}a{% endif %} class="{{ block.settings.button_style }}" {% if block.settings.button_link == blank and is_link == false %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}>
                      {{- block.settings.button_label | escape -}}
                    </{% if block.settings.button_link == blank %}button{% else %}a{% endif %}>
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

        {% if is_link %}</a>{% else %}</div>{% endif %}

      {%- endfor -%}
    </div>
  </div>

  {% if section.settings.mobile_carousel and use_featured_mobile_layout == false %}</div>{% endif %}
</div>

<script>
  (function initMediaGrid2MobileDots() {
    var sectionId = 'shopify-section-{{ section.id }}';
    var useFeaturedMobileLayout = {{ use_featured_mobile_layout | json }};
    if (!useFeaturedMobileLayout) return;

    function initDots() {
      var root = document.getElementById(sectionId);
      if (!root) return;

      var cardsWrap = root.querySelector('[data-mg2-cards]');
      var dotsWrap = root.querySelector('[data-mg2-dots]');
      if (!cardsWrap || !dotsWrap) return;

      var cards = Array.prototype.slice.call(cardsWrap.querySelectorAll('.gallery-block'));
      var dots = Array.prototype.slice.call(dotsWrap.querySelectorAll('[data-mg2-dot]'));
      if (!cards.length || !dots.length) return;

      function setActiveDot() {
        var trackRect = cardsWrap.getBoundingClientRect();
        var trackCenter = trackRect.left + (trackRect.width / 2);
        var activeIndex = 0;
        var bestDistance = Infinity;

        cards.forEach(function(card, index) {
          var rect = card.getBoundingClientRect();
          var center = rect.left + (rect.width / 2);
          var distance = Math.abs(trackCenter - center);
          if (distance < bestDistance) {
            bestDistance = distance;
            activeIndex = index;
          }
        });

        dots.forEach(function(dot, index) {
          dot.classList.toggle('is-active', index === activeIndex);
        });
      }

      function enableDragToScroll(container) {
        var pointerDown = false;
        var dragging = false;
        var suppressClick = false;
        var startX = 0;
        var startY = 0;
        var startScrollLeft = 0;

        function onPointerDown(event) {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          pointerDown = true;
          dragging = false;
          startX = event.clientX;
          startY = event.clientY;
          startScrollLeft = container.scrollLeft;
        }

        function onPointerMove(event) {
          if (!pointerDown) return;
          var dx = event.clientX - startX;
          var dy = event.clientY - startY;

          if (!dragging) {
            if (Math.abs(dx) < 6) return;
            if (Math.abs(dx) <= Math.abs(dy)) return;
            dragging = true;
            suppressClick = true;
            container.classList.add('is-dragging');
          }

          container.scrollLeft = startScrollLeft - dx;
          if (event.cancelable) event.preventDefault();
        }

        function onPointerUp() {
          pointerDown = false;
          if (dragging) {
            container.classList.remove('is-dragging');
          }
          dragging = false;
        }

        function onClickCapture(event) {
          if (!suppressClick) return;
          event.preventDefault();
          event.stopPropagation();
          suppressClick = false;
        }

        container.addEventListener('pointerdown', onPointerDown);
        container.addEventListener('pointermove', onPointerMove, { passive: false });
        container.addEventListener('pointerup', onPointerUp);
        container.addEventListener('pointercancel', onPointerUp);
        container.addEventListener('mouseleave', onPointerUp);
        container.addEventListener('click', onClickCapture, true);
      }

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          var index = parseInt(dot.getAttribute('data-mg2-dot'), 10) || 0;
          if (cards[index]) {
            cards[index].scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
          }
        });
      });

      cardsWrap.addEventListener('scroll', setActiveDot, { passive: true });
      window.addEventListener('resize', setActiveDot);
      enableDragToScroll(cardsWrap);
      setActiveDot();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDots);
    } else {
      initDots();
    }
  })();
</script>

