<link rel="stylesheet" href="{{ 'footer.css' | asset_url }}" media="print" onload="this.media='all'">

{%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
  <script src="{{ 'custom-select.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .footer {
    --bg-color: {{ section.settings.bg_color.rgba }};
    --heading-color: {{ section.settings.text_color.rgb }};
    --text-color: {{ section.settings.text_color.rgb }};
    --copyright-text-size: {{ section.settings.copyright_text_size | default: 12 }}px;
  }
  {%- if section.settings.copyright_text_bold -%}
    .footer-col-copyright {
      font-weight: bold;
    }
  {%- endif -%}
{%- endstyle -%}

{%- if section.settings.show_back_to_top -%}
  <a href="#" class="back-to-top text-sm block border-top font-bold text-center text-current p-6 border-bottom"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>{{ 'sections.footer.back_to_top' | t }}</a>
{%- endif -%}
<footer class="footer bg-theme-bg text-theme-text">
  <div class="container">
    {%- if section.blocks.size > 0 -%}
      <div class="footer__main md:flex md:flex-wrap mb-10 md:mb-6">
        {%- assign is_first_disclosure = true -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {% when '@app' %}
              <div class="footer-col footer-col--app footer-col--not-collapsed" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                <div class="footer-block mb-8">
                  {% render block %}
                </div>
              </div>

            {%- when 'text' -%}
              <div class="footer-col footer-col--text footer-col--not-collapsed{% if section.blocks.size == 1 %} footer-col--text-full-width{% endif %}" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                <div class="footer-block mb-8 {{ block.settings.text_align }}">
                  {%- if block.settings.image != blank -%}
                    <div class="media relative" style="max-width: {{ block.settings.image_width }}px;">
                      {% render 'image', class: "footer-block__image", image: block.settings.image, src_width: block.settings.image_width, srcset_2x: true %}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer-block__heading font-body font-bold text-h6 regular-text">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="footer-block__text rte">
                      {{ block.settings.text }}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <div class="footer-block__btns">
                      <a class="btn btn--primary" {% if block.settings.button_link == blank %}role="link" aria-disabled="true"{% else %}href="{{ block.settings.button_link }}"{% endif %}>
                        {{- block.settings.button_label | escape -}}
                      </a>
                    </div>
                  {%- endif -%}
                  {%- if shop.features.follow_on_shop? and block.settings.enable_follow_on_shop -%}
                    <div class="footer-block__btns">
                      {% # theme-check-disable %}
                      {{ shop | login_button: action: 'follow' }}
                      {% # theme-check-enable %}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.show_social -%}
                    {%- liquid
                      if block.settings.text_align == "text-end"
                        assign class = "justify-end"
                      elsif block.settings.text_align == "text-center"
                        assign class = "justify-center"
                      else
                        assign class = "justify-start"
                      endif
                    -%}
                    <div class="footer-block__btns footer-block__social">
                      {% render 'social-media', icon: settings.social_custom_icon, icon_height: 24, class: class %}
                    </div>
                  {%- endif -%}
                </div>
              </div>

             {%- when 'newsletter' -%}
               <div class="footer-col footer-col--newsletter footer-col--not-collapsed" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                 <div class="footer-block">
                   <h2 class="footer-block__heading font-body font-bold text-h6 regular-text">
                     {%- if block.settings.heading != blank -%}
                       {{ block.settings.heading | escape }}
                     {%- endif -%}
                   </h2>

                   {%- if block.settings.text != blank -%}
                     <div class="rte">
                       {{ block.settings.text }}
                     </div>
                   {%- endif -%}

                   {% render 'newsletter-signup', id: 'footer-signup', arrow_button: true, tags: 'newsletter' %}

                   <div class="footer-col-social">
                     {% render 'social-media' %}
                   </div>
                 </div>
               </div>

            {%- when 'link_list' -%}
              {%- if block.settings.menu != blank and block.settings.heading != blank -%}
                <div class="footer-col footer-col--links footer-col--collapsed" {{ block.shopify_attributes }}{% if settings.animations_enabled != "disabled" %} data-cc-animate data-cc-animate-delay="{{ forloop.index | times: 0.07 }}s"{% endif %}>
                  <footer-menu>
                    <details class="footer-menu disclosure{% if is_first_disclosure %} footer-menu--first{% endif %}" open>
                       <summary tabindex="-1" class="flex justify-between items-center">
                         <span class="disclosure__title font-body font-bold text-h6 regular-text">
                           {{- block.settings.heading | escape -}}
                         </span>
                         <span class="disclosure__icon">
                           {%- if settings.disclosure_toggle == 'plus' -%}
                             {% render 'icon-plus' %}
                           {%- else -%}
                             {% render 'icon-chevron-down' %}
                           {%- endif -%}
                         </span>
                       </summary>
                      <div class="disclosure__panel has-motion">
                        <ul class="footer-menu__links disclosure__content" role="list">
                          {%- for link in block.settings.menu.links -%}
                            <li>
                              <a href="{{ link.url }}">{{ link.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    </details>
                  </footer-menu>
                </div>
                {%- assign is_first_disclosure = false -%}
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.enable_country_selector or section.settings.enable_language_selector or section.settings.show_payment_icons -%}
      <div class="footer__meta grid grid-cols-1 lg:grid-cols-2 gap-x-theme gap-y-10"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
        {%- if section.settings.show_payment_icons -%}
          <div class="footer__payment{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} lg:col-start-2 lg:row-start-1 footer__payment--right{% endif %}">
            <span class="visually-hidden">{{ 'sections.footer.payment_methods' | t }}</span>
            <ul class="payment-icons flex flex-wrap" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
          <div class="lg:col-start-1 lg:row-start-1 footer__localization">
            {% render 'localization-form', id: 'footer-localization', hide_labels: true %}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 or section.settings.enable_country_selector or section.settings.enable_language_selector or section.settings.show_payment_icons -%}
    <hr class="footer__hr"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
    {% endif %}

    <div class="footer__base grid grid-cols-1 lg:grid-cols-2 gap-x-theme gap-y-6 text-xs{% if section.settings.copyright_text_align == 'text-center' %} footer__base--center{% elsif section.settings.copyright_text_align == 'text-end' %} footer__base--right{% endif %}"{% if settings.animations_enabled != "disabled" %} data-cc-animate{% endif %}>
      {%- if section.settings.show_copyright_text -%}
        <div>
          {%- if section.settings.copyright_text != blank -%}
            {%- assign copyright_year = 'now' | date: '%Y' -%}
            {%- assign dynamic_text = section.settings.copyright_text | replace: '[year]', copyright_year | replace: '[shop_name]', shop.name -%}
            <span class="footer-col-copyright {% if section.settings.copyright_text_bold %}font-bold{% endif %}" style="font-size: {{ section.settings.copyright_text_size }}px;">
              {{ dynamic_text }}
            </span>
          {%- else -%}
            {%- assign copyright_year = 'now' | date: '%Y' -%}
            <div class="footer-col-copyright">
              <span class="footer-col-copyright__line1{% if section.settings.copyright_text_bold %} font-bold{% endif %}" style="font-size: {{ section.settings.copyright_text_size }}px;">
                &copy; {{ copyright_year }} {{ shop.name }}
              </span>
              {%- if section.settings.show_all_rights_reserved -%}
                <br>
                <span class="footer-col-copyright__line2{% if section.settings.copyright_text_bold %} font-bold{% endif %}" style="font-size: {{ section.settings.copyright_text_size }}px;">
                  All Rights Reserved.
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_powered_by -%}
        <div class="footer__powered-by{% if section.settings.copyright_text_align == 'text-center' %} text-center{% elsif section.settings.copyright_text_align == 'text-end' %} text-end{% endif %}" style="font-size: {{ section.settings.copyright_text_size }}px;">
          <span class="footer-col-copyright {% if section.settings.powered_by_bold %}font-bold{% endif %}">
            {{ 'layout.footer.powered_by' | t }}
          </span>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "show_back_to_top",
      "label": "Show back to top button",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f8f8f8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Copyright Text"
    },
    {
      "type": "checkbox",
      "id": "show_copyright_text",
      "label": "Show copyright text",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Custom copyright text",
      "info": "Use [year] for current year and [shop_name] for store name. Leave blank to show default format with shop name.",
      "default": "© [year] [shop_name]"
    },
    {
      "type": "checkbox",
      "id": "show_all_rights_reserved",
      "label": "Show 'All Rights Reserved'",
      "default": true,
      "info": "Only visible when custom copyright text is blank."
    },
    {
      "type": "checkbox",
      "id": "copyright_text_bold",
      "label": "Bold copyright text",
      "default": false
    },
    {
      "type": "range",
      "id": "copyright_text_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "label": "Copyright text size",
      "default": 12,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "copyright_text_align",
      "label": "Copyright text alignment",
      "default": "text-start",
      "options": [
        {
          "value": "text-start",
          "label": "Left"
        },
        {
          "value": "text-center",
          "label": "Center"
        },
        {
          "value": "text-end",
          "label": "Right"
        }
      ]
    },
    {
      "type": "header",
      "content": "Powered By"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show 'Powered by Shopify'",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "powered_by_bold",
      "label": "Bold 'Powered by Shopify' text",
      "default": false
    },
    {
      "type": "header",
      "content": "Payment and localization"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Show country selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "label": "Show language selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 20,
          "max": 300,
          "step": 10,
          "unit": "px",
          "label": "Image width",
          "default": 120
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add your own text content and links here.</p>"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "default": "text-start",
          "options": [
            {
              "value": "text-start",
              "label": "Left"
            },
            {
              "value": "text-center",
              "label": "Center"
            },
            {
              "value": "text-end",
              "label": "Right"
            }
          ]
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "label": "Show social media links",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "enable_follow_on_shop",
          "label": "Enable Follow on Shop button",
          "info": "The Follow on Shop button appears for products that have Shop Pay installed. [Learn more](https://help.shopify.com/en/manual/online-store/themes/customizing-themes/follow-on-shop)",
          "default": true
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Sign up for our newsletter"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Subscribe to get special offers, free giveaways, and once-in-a-lifetime deals.</p>"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "Link list",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "info": "This menu won't show dropdown items."
        }
      ]
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}